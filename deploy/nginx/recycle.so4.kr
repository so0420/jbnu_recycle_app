# recycle.so4.kr -> 127.0.0.1:11010
# Cloudflare 프록시 뒤에서 동작. 인증서는 Cloudflare Origin 인증서 (so4.kr + *.so4.kr)
# map($recycle_client_ip)·log_format(recycle_private) 은 /etc/nginx/conf.d/recycle.conf 에 있다.

server {
    listen 80;
    listen [::]:80;
    server_name recycle.so4.kr;

    # Cloudflare 대역만 허용 (직접 IP 접근 차단)
    include snippets/cloudflare-allow.conf;

    access_log /var/log/nginx/recycle_access.log recycle_private;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name recycle.so4.kr;

    # Cloudflare 대역만 허용 (직접 IP 접근 차단)
    include snippets/cloudflare-allow.conf;

    ssl_certificate     /etc/ssl/certs/so4.kr.pem;
    ssl_certificate_key /etc/ssl/private/so4.kr.key;

    # 전용 로그, 쿼리(위치 좌표) 없이 기록. /var/log/nginx/*.log 로테이션(14일)을 따른다
    access_log /var/log/nginx/recycle_access.log recycle_private;

    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:11010;

        # 앱(uvicorn)은 127.0.0.1 만 신뢰하므로 이 값이 request.client.host → rate limit 키가 된다
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $recycle_client_ip;
        proxy_set_header X-Forwarded-For   $recycle_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
