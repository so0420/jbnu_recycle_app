# 서버의 deploy/.env (git 에 올리지 않음)
ENVIRONMENT=production
PUBLIC_BASE_URL=https://recycle.so4.kr
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=recycle
DB_PASSWORD=
DB_NAME=recycle
JWT_SECRET=          # 32자 이상 무작위 값 (예: openssl rand -hex 32). 비어 있으면 서버가 시작되지 않음
COOKIE_SECURE=true
ALLOWED_HOSTS=recycle.so4.kr,127.0.0.1,localhost
TRUSTED_PROXIES=127.0.0.1
DOCS_ENABLED=false
CORS_ALLOW_ORIGINS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_DAILY_TOKEN_LIMIT=10000000
REGION_MODE=sigungu   # 전국 시군구 대항 (전주 시연용 권역은 zone)
ECONOMY_MULTIPLIER=3
